# Copy to .env in the repository root. Docker Compose uses the shared settings below.
JWT_ISSUER=<auth-jwt-issuer>
BOOKING_TO_PET_TOKEN=<distinct-random-value-at-least-32-characters>
PAYMENT_TO_BOOKING_TOKEN=<distinct-random-value-at-least-32-characters>
CARE_TO_BOOKING_TOKEN=<distinct-random-value-at-least-32-characters>

# Optional refund request credential shared by Booking and Payment.
BOOKING_TO_PAYMENT_TOKEN=

PAYMENT_MYSQL_ROOT_PASSWORD=<generate-random-password>
PAYMENT_MYSQL_PASSWORD=<generate-another-random-password>

AUTH_HOST_PORT=3001
PET_HOST_PORT=3002
BOOKING_HOST_PORT=3003
PAYMENT_HOST_PORT=8084

# Catalog/Care: use a fourth distinct internal credential.
BOOKING_TO_CATALOG_TOKEN=<another-distinct-random-value-at-least-32-characters>
GATEWAY_HOST_PORT=8080
# Booking/Care demo clock; forbidden with NODE_ENV=production.
NODE_ENV=development
PAWSTAY_DEMO_ENABLED=false

# Optional Docker Compose monitoring profile.
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# VNPAY_RETURN_URL=https://api.example.com/api/payments/vnpay/return
# Use the same frontend origin that customers use to sign in.
# PAYMENT_FRONTEND_RETURN_URL=http://localhost:5173/payments/return
JWT_EXPIRES_IN=1h

# Payment and VNPAY Sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_IPN_URL=
VNPAY_REFUND_SERVER_IP=
OUTBOX_ENABLED=true
OUTBOX_BATCH_SIZE=20
OUTBOX_RETRY_DELAY=5000
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_POLL_DELAY=1000

# Frontend development proxy
PAWSTAY_GATEWAY_TARGET=http://127.0.0.1:8080

# Standalone services started with node scripts/run-local.cjs.
# Relative key paths below are relative to each service directory.

# auth-service
LOCAL_AUTH_MONGODB_URI=mongodb://127.0.0.1:27017/pawstay_auth
LOCAL_AUTH_JWT_PRIVATE_KEY_PATH=./keys/private.pem
LOCAL_AUTH_JWT_PUBLIC_KEY_PATH=./keys/public.pem
LOCAL_AUTH_FACILITY_CONTACT_FILE=./data/facility-contact.json
LOCAL_AUTH_BOOKING_BASE_URL=http://127.0.0.1:3003

# booking-service
LOCAL_BOOKING_PORT=3003
LOCAL_BOOKING_MONGODB_URI=mongodb://127.0.0.1:27017/booking_db?replicaSet=pawstay-demo&directConnection=true
LOCAL_BOOKING_AUTH_BASE_URL=http://127.0.0.1:3001
LOCAL_BOOKING_JWT_PUBLIC_KEY_PATH=../auth-service/keys/public.pem
LOCAL_BOOKING_HTTP_TIMEOUT_MS=3000
LOCAL_BOOKING_PET_BASE_URL=http://127.0.0.1:3002
LOCAL_BOOKING_CATALOG_MODE=http
LOCAL_BOOKING_CATALOG_BASE_URL=http://127.0.0.1:3004
LOCAL_BOOKING_PAYMENT_BASE_URL=
LOCAL_BOOKING_WORKER_ENABLED=true
LOCAL_BOOKING_WORKER_INTERVAL_MS=5000
LOCAL_BOOKING_OPEN_TIME=08:00
LOCAL_BOOKING_CLOSE_TIME=18:00
LOCAL_BOOKING_BOARDING_CHECK_IN_TIME=14:00
LOCAL_BOOKING_BOARDING_CHECK_OUT_TIME=12:00
LOCAL_BOOKING_PREPARATION_MINUTES=15
LOCAL_BOOKING_CLEANING_MINUTES=30
LOCAL_BOOKING_CHECK_IN_EARLY_MINUTES=60
LOCAL_BOOKING_CHECK_IN_LATE_MINUTES=120

# care-service
LOCAL_CARE_PORT=3006
LOCAL_CARE_MONGODB_URI=mongodb://127.0.0.1:27017/care_db?replicaSet=pawstay-demo&directConnection=true
LOCAL_CARE_AUTH_BASE_URL=http://127.0.0.1:3001
LOCAL_CARE_JWT_PUBLIC_KEY_PATH=../auth-service/keys/public.pem
LOCAL_CARE_HTTP_TIMEOUT_MS=3000
LOCAL_CARE_BOOKING_BASE_URL=http://127.0.0.1:3003
LOCAL_CARE_WORKER_ENABLED=true
LOCAL_CARE_WORKER_INTERVAL_MS=5000

# catalog-service
LOCAL_CATALOG_PORT=3004
LOCAL_CATALOG_MONGODB_URI=mongodb://127.0.0.1:27017/catalog_db?replicaSet=pawstay-demo&directConnection=true
LOCAL_CATALOG_AUTH_BASE_URL=http://127.0.0.1:3001
LOCAL_CATALOG_JWT_PUBLIC_KEY_PATH=../auth-service/keys/public.pem
LOCAL_CATALOG_HTTP_TIMEOUT_MS=3000

# payment-service
LOCAL_PAYMENT_PAYMENT_PORT=8084
LOCAL_PAYMENT_PAYMENT_DB_URL=jdbc:mysql://localhost:3306/payment_db
LOCAL_PAYMENT_PAYMENT_DB_USERNAME=payment_app
LOCAL_PAYMENT_PAYMENT_DB_PASSWORD=<payment-database-password>
LOCAL_PAYMENT_AUTH_SERVICE_URL=http://localhost:3001
LOCAL_PAYMENT_JWT_PUBLIC_KEY_PATH=../auth-service/keys/public.pem
LOCAL_PAYMENT_BOOKING_SERVICE_URL=http://localhost:3003
LOCAL_PAYMENT_VNPAY_RETURN_URL=http://localhost:8084/api/payments/vnpay/return
LOCAL_PAYMENT_PAYMENT_FRONTEND_RETURN_URL=

# pet-service
LOCAL_PET_PORT=3002
LOCAL_PET_MONGODB_URI=mongodb://127.0.0.1:27017/pet_db?replicaSet=pawstay-demo&directConnection=true
LOCAL_PET_AUTH_BASE_URL=http://127.0.0.1:3001
LOCAL_PET_JWT_PUBLIC_KEY_PATH=../auth-service/keys/public.pem
LOCAL_PET_HTTP_TIMEOUT_MS=3000
