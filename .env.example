# Compose variables. Copy to .env in the repository root.
JWT_ISSUER=<auth-jwt-issuer>
AUTH_BASE_URL_DOCKER=http://host.docker.internal:3001
BOOKING_TO_PET_TOKEN=<distinct-random-value-at-least-32-characters>
PAYMENT_TO_BOOKING_TOKEN=<distinct-random-value-at-least-32-characters>
CARE_TO_BOOKING_TOKEN=<distinct-random-value-at-least-32-characters>

PAYMENT_MYSQL_ROOT_PASSWORD=<generate-random-password>
PAYMENT_MYSQL_PASSWORD=<generate-another-random-password>

PET_HOST_PORT=3002
BOOKING_HOST_PORT=3003
PAYMENT_HOST_PORT=8084
