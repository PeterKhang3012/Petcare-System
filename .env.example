# Copy to .env at the repository root. Use the same issuer as Auth.
JWT_ISSUER=<auth-jwt-issuer>
AUTH_BASE_URL_DOCKER=http://host.docker.internal:3001

# Use three distinct random values, at least 32 characters each.
# Match PAYMENT_TO_BOOKING_TOKEN with Payment when testing that integration.
BOOKING_TO_PET_TOKEN=<generate-random-value>
PAYMENT_TO_BOOKING_TOKEN=<generate-random-value>
CARE_TO_BOOKING_TOKEN=<generate-random-value>

PET_HOST_PORT=3002
BOOKING_HOST_PORT=3003
