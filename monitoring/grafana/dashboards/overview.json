      "datasource": {
        "type": "prometheus",
        "uid": "pawstay-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(1 - up{service=~\"$service\"}) or vector(0)",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "pawstay-prometheus"
