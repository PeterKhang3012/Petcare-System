          "legendFormat": "{{service}} P50",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "pawstay-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(pawstay_http_request_duration_seconds_bucket{service=~\"$service\"}[$__rate_interval]) or rate(http_server_requests_seconds_bucket{service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{service}} P95",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "pawstay-prometheus"
