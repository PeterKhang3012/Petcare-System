{
  "uid": "pawstay-overview",
  "title": "PawStay Service Overview",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "pawstay"
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "System Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Monitored services",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "pawstay-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{service=~\"$service\"}) or vector(0)",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "pawstay-prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "UP",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "pawstay-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{service=~\"$service\"}) or vector(0)",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
