    {
      "id": 5,
      "title": "HTTP requests",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "pawstay-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (increase(pawstay_http_request_duration_seconds_count{service=~\"$service\"}[$__range]) or increase(http_server_requests_seconds_count{service=~\"$service\"}[$__range])) or vector(0)",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "pawstay-prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "HTTP errors (4xx and 5xx)",
      "type": "stat",
      "datasource": {
