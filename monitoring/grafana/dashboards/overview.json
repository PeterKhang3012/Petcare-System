      "targets": [
        {
          "refId": "A",
          "expr": "sum (increase(pawstay_http_request_duration_seconds_count{service=~\"$service\",status=~\"[45]..\"}[$__range]) or increase(http_server_requests_seconds_count{service=~\"$service\",status=~\"[45]..\"}[$__range])) or vector(0)",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "pawstay-prometheus"
          }
