    {
      "id": 12,
      "title": "HTTP error rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pawstay-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (service) (rate(pawstay_http_request_duration_seconds_count{service=~\"$service\",status=~\"[45]..\"}[$__rate_interval]) or rate(http_server_requests_seconds_count{service=~\"$service\",status=~\"[45]..\"}[$__rate_interval])) or (0 * sum by (service) (rate(pawstay_http_request_duration_seconds_count{service=~\"$service\"}[$__rate_interval]) or rate(http_server_requests_seconds_count{service=~\"$service\"}[$__rate_interval])))) / sum by (service) (rate(pawstay_http_request_duration_seconds_count{service=~\"$service\"}[$__rate_interval]) or rate(http_server_requests_seconds_count{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "pawstay-prometheus"
