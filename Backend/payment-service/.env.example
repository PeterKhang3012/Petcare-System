# Standalone settings. Compose overrides DB, service URLs, JWT and internal token.
PAYMENT_PORT=8084
PAYMENT_DB_URL=jdbc:mysql://localhost:3306/payment_db
PAYMENT_DB_USERNAME=payment_app
PAYMENT_DB_PASSWORD=<payment-database-password>
AUTH_SERVICE_URL=http://localhost:3001
JWT_PUBLIC_KEY_PATH=../auth-service/keys/public.pem
JWT_ISSUER=<auth-jwt-issuer>
BOOKING_SERVICE_URL=http://localhost:3003
PAYMENT_TO_BOOKING_TOKEN=<same-token-as-booking>

# Compose and standalone both use these VNPAY settings.
VNPAY_TMN_CODE=<sandbox-merchant-code>
VNPAY_HASH_SECRET=<sandbox-hash-secret>
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8084/api/payments/vnpay/return
VNPAY_IPN_URL=
PAYMENT_FRONTEND_RETURN_URL=

OUTBOX_ENABLED=true
OUTBOX_BATCH_SIZE=20
OUTBOX_RETRY_DELAY=5000
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_POLL_DELAY=1000
