PAYMENT_PORT=8084
PAYMENT_DB_URL=jdbc:mysql://localhost:3306/payment_db
PAYMENT_DB_USERNAME=payment_app
PAYMENT_DB_PASSWORD=<replace-me>
BOOKING_SERVICE_URL=<booking-base-url>
PAYMENT_TO_BOOKING_TOKEN=<same-token-as-booking>
AUTH_SERVICE_URL=<auth-base-url>
JWT_PUBLIC_KEY_PATH=<path-to-auth-public-pem>
JWT_ISSUER=<same-issuer-as-auth>
VNPAY_TMN_CODE=<sandbox-merchant-code>
VNPAY_HASH_SECRET=<sandbox-hash-secret>
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=<payment-public-url>/api/payments/vnpay/return
VNPAY_IPN_URL=<payment-public-https-url>/api/payments/vnpay/ipn
PAYMENT_FRONTEND_RETURN_URL=<frontend-result-page>
OUTBOX_BATCH_SIZE=20
OUTBOX_RETRY_DELAY=5000
OUTBOX_ENABLED=true
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_POLL_DELAY=1000
