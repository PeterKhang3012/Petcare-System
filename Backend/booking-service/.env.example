NODE_ENV=development
PORT=3003
MONGODB_URI=mongodb://booking_user:you_password@127.0.0.1:27028/booking_db?authSource=booking_db&replicaSet=pawstay-demo&directConnection=true
AUTH_BASE_URL=http://127.0.0.1:3001
JWT_PUBLIC_KEY_PATH=../auth-service/keys/public.pem
JWT_ISSUER=pawstay-auth
HTTP_TIMEOUT_MS=3000
PET_BASE_URL=http://127.0.0.1:3002
BOOKING_TO_PET_TOKEN=
PAYMENT_TO_BOOKING_TOKEN=
CARE_TO_BOOKING_TOKEN=
# Default HTTP mode fails closed if Catalog has not been connected.
CATALOG_MODE=http
CATALOG_BASE_URL=
BOOKING_TO_CATALOG_TOKEN=
# Optional: pending refund requests remain durable until Payment is connected.
PAYMENT_BASE_URL=
BOOKING_TO_PAYMENT_TOKEN=
WORKER_ENABLED=true
WORKER_INTERVAL_MS=5000
PAWSTAY_DEMO_ENABLED=false
OPEN_TIME=08:00
CLOSE_TIME=18:00
BOARDING_CHECK_IN_TIME=14:00
BOARDING_CHECK_OUT_TIME=12:00
PREPARATION_MINUTES=15
CLEANING_MINUTES=30
CHECK_IN_EARLY_MINUTES=60
CHECK_IN_LATE_MINUTES=120
