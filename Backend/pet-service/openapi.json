          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          },
          {
            "name": "owner_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "security": [
          {
            "serviceToken": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT RS256"
      },
      "serviceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Token"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "success",
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "PetCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "species": {
            "type": "string",
            "enum": [
              "DOG",
              "CAT"
            ]
          },
          "breed": {
            "type": "string",
            "maxLength": 100
          },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "description": "Valid day, year >=1900, not later than today in Asia/Ho_Chi_Minh"
          },
          "weight_kg": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 500
          },
          "care_notes": {
            "type": "string",
            "maxLength": 2000
          },
          "coat_type": {
            "type": "string",
            "enum": [
              "SHORT",
              "LONG"
            ],
            "description": "Required to quote a service priced by pet group. Older pet profiles may lack this field."
          }
        },
        "required": [
          "name",
          "species",
          "weight_kg"
        ],
        "additionalProperties": false
      },
      "PetPatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "species": {
            "type": "string",
            "enum": [
              "DOG",
              "CAT"
            ]
          },
          "breed": {
            "type": "string",
            "maxLength": 100
          },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "description": "Valid day, year >=1900, not later than today in Asia/Ho_Chi_Minh"
          },
          "weight_kg": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 500
          },
          "care_notes": {
            "type": "string",
            "maxLength": 2000
          },
          "coat_type": {
            "type": "string",
            "enum": [
              "SHORT",
              "LONG"
            ],
            "description": "Required to quote a service priced by pet group. Older pet profiles may lack this field."
          }
        },
        "required": [],
        "additionalProperties": false,
        "minProperties": 1
      },
      "Pet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "owner_id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "species": {
            "type": "string",
            "enum": [
              "DOG",
              "CAT"
            ]
          },
          "breed": {
            "type": "string",
            "maxLength": 100
          },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "description": "Valid day, year >=1900, not later than today in Asia/Ho_Chi_Minh"
          },
          "weight_kg": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 500
          },
          "care_notes": {
            "type": "string",
            "maxLength": 2000
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "ARCHIVED"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "archived_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "coat_type": {
            "type": "string",
            "enum": [
              "SHORT",
              "LONG"
            ],
            "description": "Required to quote a service priced by pet group. Older pet profiles may lack this field."
          }
        },
        "required": [
          "id",
          "owner_id",
          "name",
          "species",
          "weight_kg",
          "status",
          "version",
          "created_at",
          "updated_at",
          "archived_at"
        ],
        "additionalProperties": false
      }
    },
    "responses": {
      "Error": {
        "description": "Validation, authentication, authorization, conflict, dependency or internal error. No stack or connection details.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
