          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ]
      },
      "patch": {
        "summary": "USER edits an ACTIVE pet",
        "description": "owner_id, status, version and timestamps are rejected. Archived profiles cannot be edited (409 INVALID_PET_STATE).",
        "operationId": "patch_api_pets__id_",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "description": "Validated request correlation ID or generated UUID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "pet": {
                          "$ref": "#/components/schemas/Pet"
                        }
                      },
                      "required": [
                        "pet"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "success",
