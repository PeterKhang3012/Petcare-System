    "/api/pets/{id}/archive": {
      "post": {
        "summary": "USER archives a pet idempotently",
        "description": "An empty JSON object is accepted; the body may also be omitted. Replays preserve archived_at and version. Existing bookings and snapshots remain intact.",
        "operationId": "post_api_pets__id__archive",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
