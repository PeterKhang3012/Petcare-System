{
  "openapi": "3.0.3",
  "info": {
    "title": "PawStay Pet Service",
    "version": "1.0.0",
    "description": "Node.js/Express/CommonJS/Mongoose. USER and STAFF are resolved through existing Auth /api/auth/me on every business request. UTC timestamps; VND integers. Internal caller identity comes only from a directional credential."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Process liveness",
        "description": "",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "description": "Validated request correlation ID or generated UUID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "service": {
                          "type": "string",
                          "enum": [
                            "pet"
                          ]
                        },
                        "live": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "service",
                        "live"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/ready": {
      "get": {
        "summary": "Database readiness",
        "description": "Requires a working connection to pet_db. Does not guarantee Auth availability.",
        "operationId": "get_ready",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "description": "Validated request correlation ID or generated UUID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "ready": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "ready"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": []
      }
    },
    "/api/pets": {
      "post": {
        "summary": "USER creates their own pet",
        "description": "",
        "operationId": "post_api_pets",
        "responses": {
          "201": {
            "description": "Success",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "description": "Validated request correlation ID or generated UUID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "pet": {
                          "$ref": "#/components/schemas/Pet"
                        }
                      },
                      "required": [
                        "pet"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PetCreate"
              }
            }
          }
        }
      },
      "get": {
        "summary": "USER lists their own pets",
        "description": "",
        "operationId": "get_api_pets",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "description": "Validated request correlation ID or generated UUID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "pets": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Pet"
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "limit": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "pets",
                        "page",
                        "limit",
                        "total"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "ARCHIVED",
                "ALL"
              ],
              "default": "ACTIVE"
            }
          }
        ]
      }
    },
    "/api/pets/{id}": {
      "get": {
        "summary": "USER reads their pet, including archived",
        "description": "Out-of-ownership objects consistently return 404.",
        "operationId": "get_api_pets__id_",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "description": "Validated request correlation ID or generated UUID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
