    "/internal/pets/{id}/booking-context": {
      "get": {
        "summary": "Read the active pet context for a new booking",
        "description": "Only BOOKING_TO_PET_TOKEN credential is allowed. Caller must derive owner_id from current Auth identity. Missing, archived or wrong owner all return 404. No cross-service transaction is implied.",
        "operationId": "get_internal_pets__id__booking_context",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "description": "Validated request correlation ID or generated UUID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "pet": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[a-fA-F0-9]{24}$"
                            },
                            "owner_id": {
                              "type": "string",
                              "pattern": "^[a-fA-F0-9]{24}$"
                            },
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 100
                            },
                            "species": {
                              "type": "string",
                              "enum": [
                                "DOG",
                                "CAT"
                              ]
                            },
                            "breed": {
                              "type": "string",
                              "maxLength": 100
                            },
                            "weight_kg": {
                              "type": "number",
                              "minimum": 0,
                              "exclusiveMinimum": true,
                              "maximum": 500
                            },
                            "care_notes": {
                              "type": "string",
                              "maxLength": 2000
                            },
                            "version": {
                              "type": "integer"
                            },
                            "coat_type": {
                              "type": "string",
                              "enum": [
                                "SHORT",
                                "LONG"
                              ],
                              "description": "Required to quote a service priced by pet group. Older pet profiles may lack this field."
                            }
                          },
                          "required": [
                            "id",
                            "owner_id",
                            "name",
                            "species",
                            "weight_kg",
                            "version"
                          ],
                          "additionalProperties": false
                        }
