NODE_ENV=development
PORT=3002
# Supply a dedicated pet_db readWrite account. Never use the Auth connection.
MONGODB_URI=mongodb://pet_user:REPLACE_LOCALLY@127.0.0.1:27028/pet_db?authSource=pet_db&replicaSet=pawstay-demo&directConnection=true
AUTH_BASE_URL=http://127.0.0.1:3001
JWT_PUBLIC_KEY_PATH=../auth-service/keys/public.pem
JWT_ISSUER=pawstay-auth
HTTP_TIMEOUT_MS=3000
# Generate a random credential of at least 32 characters; same value in Booking.
BOOKING_TO_PET_TOKEN=
