    "/api/catalog/services/{serviceId}/price": {
      "patch": {
        "summary": "Create a price version",
        "description": "Requires STAFF with UPDATE_SERVICE_PRICE. The expected version guards against concurrent edits. Send price_rule_id for grouped pricing.",
        "tags": [
          "Catalog"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "serviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
