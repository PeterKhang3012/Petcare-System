        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "unit_price": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "expected_price_version": {
                    "type": "string"
                  },
                  "price_rule_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "unit_price",
                  "reason",
                  "expected_price_version"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
