{
  "openapi": "3.0.3",
  "info": {
    "title": "PawStay Catalog",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/internal/catalog/quotes": {
      "post": {
        "summary": "Calculate a quote for a pet profile",
        "description": "Service-to-service only. The gateway does not forward this route.",
        "tags": [
          "Internal"
        ],
        "security": [
          {
            "serviceToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "service_id": {
                    "type": "string"
                  },
                  "species": {
                    "type": "string",
                    "enum": [
                      "DOG",
                      "CAT"
                    ]
                  },
                  "weight_kg": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMinimum": true
                  },
                  "coat_type": {
                    "type": "string",
                    "enum": [
                      "SHORT",
                      "LONG"
                    ]
                  }
                },
                "required": [
                  "service_id",
                  "species",
                  "weight_kg"
                ]
              },
              "example": {
                "service_id": "bath",
                "species": "CAT",
                "weight_kg": 4,
                "coat_type": "SHORT"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "quote": {
                          "type": "object",
                          "properties": {
                            "service_id": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            },
                            "type": {
                              "type": "string",
                              "enum": [
                                "CARE",
                                "BOARDING"
                              ]
                            },
                            "allowed_species": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "DOG",
                                  "CAT"
                                ]
                              }
                            },
                            "min_weight_kg": {
                              "type": "number"
                            },
                            "max_weight_kg": {
                              "type": "number"
                            },
                            "unit": {
                              "type": "string",
                              "enum": [
                                "SERVICE",
                                "NIGHT"
                              ]
                            },
                            "duration_minutes": {
                              "type": "integer",
                              "nullable": true
                            },
                            "price_version_id": {
                              "type": "string"
                            },
                            "unit_price": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "currency": {
                              "type": "string",
                              "enum": [
                                "VND"
                              ]
                            },
                            "price_rule_id": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "service_id",
                            "name",
                            "type",
                            "allowed_species",
                            "min_weight_kg",
                            "max_weight_kg",
                            "unit",
                            "duration_minutes",
                            "price_version_id",
                            "unit_price",
                            "currency"
                          ]
                        }
                      },
                      "required": [
                        "quote"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
